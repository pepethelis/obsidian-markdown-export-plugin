{
	"name": "tg-markdown-export-plugin",
	"version": "0.10.0",
	"description": "Export markdown files to properly formatted telegram messages.",
	"main": "main.js",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"version": "bun version-bump.mjs && git add manifest.json versions.json",
		"typecheck": "tsc --noEmit -skipLibCheck"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "8.74.0",
		"@typescript-eslint/parser": "8.74.0",
		"builtin-modules": "5.5.0",
		"esbuild": "0.28.2",
		"obsidian": "1.14.4",
		"tslib": "2.9.1",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@types/bun": "1.4.5"
	}
}
